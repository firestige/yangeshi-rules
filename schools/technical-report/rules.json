    "patterns": {
      "degree": "(硕士|博士)(?:研究生)?(?:学位|毕业)论文",
      "chapter_detect": "^(?:第\\s*[一二三四五六七八九十0-9]+\\s*章\\s*|[1-9][0-9]*\\s+)\\S",
      "toc_style": "\\bTOC\\s*\\d|目录\\s*\\d|[一二三四五六]级目录",
      "heading_style": "heading|标题",
      "keywords_zh": "^关键词\\s*[:：]",
      "keywords_en": "^KEY\\s*WORDS\\s*[:：]",
      "toc_level": "(?:\\bTOC|目录)\\s*([123])",
      "toc_level_chinese": "([一二三])级目录",
      "caption_detect": "^[图表]\\s*\\d+[.\\-－]\\d+(?:[\\s\\u3000]+|[:：])\\S",
      "caption_style": "Caption|题注",
      "school_identity": "南京大学|Nanjing University",
      "chapter_parts": "^第\\s*([一二三四五六七八九十零〇\\d]+)\\s*章\\s*(.*)",
      "caption_parts": "^([图表])\\s*([A-Z\\d]+)([.\\-－])(\\d+)(.*)",
      "cover_date": "([二〇零一三四五六七八九十\\d]{4})年\\s*([一二三四五六七八九十\\d]{1,2})月",
      "security_label": "(密级|保密级别)\\s*[:：]?\\s*(.+)",
      "keyword_prefix": "^(?:关键词|KEY\\s*WORDS)\\s*[:：]\\s*",
      "school_code": "学校\\s*代码\\s*[:：]?\\s*(\\d+)",
      "innovation_heading": "(?!)",
      "template_instructions": "^(?:此处插入|报告正文按引言|参考文献插在此处|附录是正文的辅助材料|X{8,})",
      "thesis_title": "论文题目|论文题名|题目|题名",
      "keyword_label": "^(?:关键词\\s*[:：]|KEY\\s*WORDS\\s*[:：])",
      "title_page_signals": "中图分类号|UDC",
      "introduction_fallback": "^引言$",
      "conclusion_fallback": "^(?:[0-9]+\\s+)?结论$",
      "classification_placeholder": "UDC|学校|[xX×]{2,}|待填",
      "protected_punctuation": "《[^》]*》|“[^”]*”|‘[^’]*’|\"[^\"]*\"|\\[[^\\]]*\\]|(?:https?://|doi:)\\S+",
      "date_components": "\\s*[:：]?\\s*(\\d{4})年\\s*(\\d{1,2})月\\s*(\\d{1,2})日",
      "section_detect": "^([1-9]\\d*(?:\\.[1-9]\\d*){1,5})[\\s\\u3000]+\\S",
      "numeric_citation_detect": "\\[\\d+(?:\\s*[,，–—-]\\s*\\d+)*\\]",
      "author_year_citation": "[（(][A-Za-z\\u4e00-\\u9fff][^()（）\\n]{0,60}[,，]\\s*(?:19|20)\\d{2}[a-z]?[）)]",
      "display_equation_text": "\\s*(?:[._─—-]*[（(]?[A-Z\\d]+[.\\-]\\d+[）)]?)?\\s*",
      "numeric_reference_detect": "^\\s*\\[\\d+\\]",
      "toc_hyperlink": "HYPERLINK.*_Toc",
      "achievement_heading": "(?!)",
      "appendix_heading": "附\\s*录(?:\\s*[A-ZＡ-Ｚ])?(?:[\\s\\u3000]+.*)?",
      "degree_kind": "(?!)",
      "symbol_sort_key": "\\s*([A-Za-zΑ-Ωα-ω]+)",
      "appendix_key": "附录[A-ZＡ-Ｚ].*",
      "equation_number": "[A-Z\\d]+[.\\-]\\d+",
      "note_sequence": "^注\\s*(\\d+)",
      "chapter_in_appendix": "^第.*章",
      "academic_degree_kind": "(?!)",
      "greek_symbols": "[α-ωΑ-Ω]",
      "abbreviations": "[（(]([A-Z]{2,8})[）)]",
      "title_delimiter": "[:：]",
      "note_label": "^注\\s*(?:\\d+[.、)）]?\\s*|[:：])",
      "note_style": "图注|表注|分图题",
      "subfigure_label": "^\\([a-z]\\)\\s*\\S",
      "terminal_punctuation": "[，。；：！？,.!?:;]$",
      "security_duration": "[一二三四五六七八九十\\d]+\\s*年",
      "ai_heading": "(?!)",
      "chapter_prefix": "^第\\s*[一二三四五六七八九十零〇\\d]+\\s*章\\s*",
      "equation_number_parentheses": "[（(][A-Z\\d]+[.\\-]\\d+[）)]",
      "equation_connector": "[._─—-]{2,}",
      "english_keyword_bad_separator": ",\\S|，",
      "toc_excluded_heading": "^(?:摘\\s*要|ABSTRACT|目\\s*录|原创性声明)(?:\\s|\\d|[.．]|$)",
      "list_entry_number": "^[图表]?\\s*([A-Z\\d]+)[.\\-－](\\d+)",
      "reference_number": "^\\s*\\[(\\d+)\\]",
      "numeric_citation_parts": "\\[([\\d,，;；\\s–—\\-]+)\\]",
      "reference_author": "^\\s*(?:\\[\\d+\\]\\s*)?([^,，.。]+)",
      "section_parts": "^(\\d+(?:\\.\\d+)+)(\\s*)(.*)",
      "heading_gap": "^(?:第\\s*[一二三四五六七八九十零〇\\d]+\\s*章|\\d+(?:\\.\\d+)+)(\\s*)\\S",
      "achievement_date": "\\b((?:19|20)\\d{2})(?:[年./-](0?[1-9]|1[0-2]))?",
      "latin_author": "[A-Za-z][A-Za-z\\s\\-\\']*",
      "chinese_author": "[\\u4e00-\\u9fff、\\s]+",
      "appendix_title": "^附\\s*录\\s*[A-ZＡ-Ｚ]\\s+\\S",
      "numeric_citation_span": "\\[[\\d,，;；\\s–—\\-]+\\]",
      "page_decoration": "[—–_─－]",
      "section_depth": "^([1-9]\\d*(?:\\.[1-9]\\d*)+)\\s",
      "reference_title": "[.。．]\\s*(.+?)\\[[A-Z]{1,3}(?:/[A-Z]{1,3})?\\]",
      "embedded_chinese": "[\\u3400-\\u9fff][\\u3400-\\u9fff，。；：！？（）“”‘’、\\s]*",
      "object_mention": "{kind}\\s*{prefix}[.\\-－]{number}(?!\\d)",
      "appendix_parts": "^\\s*附\\s*录\\s*(?:([A-ZＡ-Ｚ])(?=\\s|$)\\s*)?(.*?)\\s*$",
      "appendix_gap": "^附\\s*录\\s*[A-ZＡ-Ｚ]\\u3000\\S",
      "number_parts": "([A-Z\\d]+)([.\\-－])(\\d+)",
      "linked_number": "{label}\\s*[（(]?({number})(?![\\dA-Z])",
      "bare_appendix_reference": "(?!)",
      "named_appendix_reference": "(?!)"
    },
